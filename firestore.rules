rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reemplaza UID_ADMIN por el UID de tu cuenta administradora de Firebase Authentication.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "UID_ADMIN";
    }

    // El catálogo puede mostrarse públicamente; solo el administrador lo modifica.
    match /productos/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Datos internos: nunca se exponen al público.
    match /ventas/{saleId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /deudas/{debtId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /clientes/{clientId} {
      allow read, write: if isAdmin();
    }

    // Los clientes pueden enviar ideas; solo el administrador puede consultarlas o gestionarlas.
    match /sugerencias/{suggestionId} {
      allow create: if request.resource.data.keys().hasOnly(["idea", "cliente", "estado", "creadoEn"])
        && request.resource.data.idea is string
        && request.resource.data.idea.size() > 0
        && request.resource.data.idea.size() <= 60
        && request.resource.data.cliente is string
        && request.resource.data.cliente.size() <= 20
        && request.resource.data.estado == "nueva"
        && request.resource.data.creadoEn == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}